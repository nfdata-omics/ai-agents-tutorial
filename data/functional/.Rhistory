fill = "white",                    # white label background
label.size = 0.35,                 # border thickness
label.padding = unit(0.25, "lines"),
box.padding = 0.3,                 # push labels apart
point.padding = 0.2,               # space from point
max.overlaps = Inf,                # allow many labels, let repel handle
show.legend = FALSE
) +
xlim(0, 6) + ylim(0, 6) +
labs(
x = "Fit",
y = "Power",
title = "Scatterplot with Labels (Repelled & Hue-colored)"
) +
# A pleasant qualitative palette (distinct hues)
scale_color_brewer(palette = "Dark2") +
theme_minimal(base_size = 16) +
theme(
axis.line = element_line(size = 1.2, color = "black"),
axis.ticks = element_line(size = 1.2, color = "black"),
panel.grid = element_line(color = "grey85"),
plot.title = element_text(hjust = 0.5, face = "bold")
)
